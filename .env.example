# Copy to .env and fill in. Never commit .env.
# Credentials come from your AWS profile / SSO, never from this file.

AWS_PROFILE=your-profile
IRA_AWS_REGION=us-east-1

# Model IDs are verified with: uv run python scripts/verify_model_access.py
# Use an inference profile ID if your region requires one.
IRA_AGENT_MODEL_ID=replace-with-agent-model-id
IRA_EMBEDDING_MODEL_ID=replace-with-embedding-model-id
# Must match the model (Titan Text Embeddings v2: 256, 512 or 1024).
IRA_EMBEDDING_DIMENSIONS=1024

# Filled in from CDK stack outputs once deployed (later modules). Leave commented until then.
# IRA_KNOWLEDGE_BASE_ID=
# IRA_AGENT_ID=
# IRA_AGENT_ALIAS_ID=

# dev | staging | prod
IRA_STAGE=dev
IRA_LOG_LEVEL=INFO

# Budget caps
IRA_MAX_TOKENS_PER_INCIDENT=50000
IRA_MAX_COST_USD_PER_INCIDENT=0.50
IRA_MONTHLY_BUDGET_USD=20

# Timeouts (seconds)
IRA_TOOL_TIMEOUT_S=10
IRA_AGENT_TIMEOUT_S=120
